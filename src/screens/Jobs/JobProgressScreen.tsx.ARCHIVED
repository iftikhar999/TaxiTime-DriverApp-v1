import { useNavigation } from '@react-navigation/native';
import React, { useCallback, useEffect, useMemo, useRef, useState } from 'react';
import {
    Alert,
    SafeAreaView,
    ScrollView,
    StyleSheet,
    Text,
    TouchableOpacity,
    View
} from 'react-native';
import Toast from 'react-native-toast-message';
import MCIcon from 'react-native-vector-icons/MaterialCommunityIcons';
import RideMap from '../../components/RideMap';
import { useAuth } from '../../context/AuthContext';
import { JobStatus, useJob } from '../../context/JobContext';
import { useLocation } from '../../context/LocationContext';
import { useShift } from '../../context/ShiftContext';
import { calculateDistance } from '../../utils/distance';

const makeCoordinate = (
  latitude: number | null | undefined,
  longitude: number | null | undefined
) => {
  if (
    typeof latitude === 'number' &&
    Number.isFinite(latitude) &&
    typeof longitude === 'number' &&
    Number.isFinite(longitude)
  ) {
    return { latitude, longitude };
  }
  return undefined;
};

const formatElapsed = (seconds: number) => {
  const minutes = Math.floor(seconds / 60);
  const remainder = seconds % 60;
  return `${minutes.toString().padStart(2, '0')}m ${remainder.toString().padStart(2, '0')}s`;
};

type StatusBanner = {
  title: string;
  subtitle: string;
};

const STATUS_BANNERS: Partial<Record<JobStatus, StatusBanner>> = {
  ASSIGNED: { title: 'Job Accepted', subtitle: 'Proceed to pickup location.' },
  ACCEPTED: { title: 'Job Accepted', subtitle: 'Proceed to pickup location.' },
  ON_THE_WAY: { title: 'Status Updated', subtitle: 'You are marked as "On the Way".' },
  ARRIVED: { title: 'Arrived', subtitle: 'Please confirm with the rider.' },
  STARTED: { title: 'Ride Started', subtitle: 'Safe travels!' },
  ACTIVE: { title: 'Ride In Progress', subtitle: 'Meter is running.' },
  REACHED: { title: 'Reached Destination', subtitle: 'Wrap up the trip with the rider.' },
  CANCELLED: { title: 'Ride Cancelled', subtitle: 'Job returned to the queue.' },
};

type StatusAction = {
  next: JobStatus;
  label: string;
  icon: string;
  color: string;
};

const STATUS_ACTIONS: Partial<Record<JobStatus, StatusAction>> = {
  ASSIGNED: { next: 'ON_THE_WAY', label: 'Proceed to Pickup', icon: 'navigation-variant', color: '#3b82f6' },
  ACCEPTED: { next: 'ON_THE_WAY', label: 'Proceed to Pickup', icon: 'navigation-variant', color: '#3b82f6' },
  ON_THE_WAY: { next: 'ARRIVED', label: 'Mark Arrived', icon: 'map-marker-check', color: '#38bdf8' },
  ARRIVED: { next: 'STARTED', label: 'Start Ride', icon: 'play-circle', color: '#22c55e' },
  REACHED: { next: 'COMPLETED', label: 'Complete Ride', icon: 'flag-checkered', color: '#f97316' }
};

const JobProgressScreen: React.FC = () => {
  const navigation = useNavigation<any>();
  const { 
    currentJob, 
    status, 
    updateStatus, 
    pendingAction, 
    timer, 
    routePoints,
    pricingBreakdown, // ✨ NEW: Real-time pricing from job processor
    pauseJob,         // ✨ NEW: Pause functionality
  } = useJob();
  const { driver } = useAuth();
  const { selectedTariff } = useShift();
  const { location } = useLocation();

  // ✅ FIX: Move navigation effect after all hooks to prevent "fewer hooks" error
  useEffect(() => {
    if (!currentJob) {
      setTimeout(() => navigation.goBack(), 100);
    }
  }, [currentJob, navigation]);

  const pickupCoordinate = useMemo(
    () => makeCoordinate(currentJob?.pickupLatitude ?? null, currentJob?.pickupLongitude ?? null),
    [currentJob?.pickupLatitude, currentJob?.pickupLongitude]
  );
  const dropoffCoordinate = useMemo(
    () => makeCoordinate(currentJob?.dropoffLatitude ?? null, currentJob?.dropoffLongitude ?? null),
    [currentJob?.dropoffLatitude, currentJob?.dropoffLongitude]
  );
  // ✨ NEW: Include heading and speed for 3D map tracking
  const driverCoordinate = useMemo(
    () => {
      const coord = makeCoordinate(location?.latitude ?? null, location?.longitude ?? null);
      if (coord) {
        return {
          ...coord,
          heading: location?.heading ?? null,
          speed: location?.speed ?? null,
        };
      }
      return coord;
    },
    [location?.latitude, location?.longitude, location?.heading, location?.speed]
  );

  const canonicalStatus: JobStatus = useMemo(() => {
    if (status === 'ACCEPTED') {
      return 'ASSIGNED';
    }
    if (status === 'ACTIVE') {
      return 'STARTED';
    }
    return status;
  }, [status]);

  const banner = STATUS_BANNERS[status] ?? STATUS_BANNERS[canonicalStatus];
  const primaryAction =
    STATUS_ACTIONS[canonicalStatus] ??
    (canonicalStatus === 'INCOMING' ? STATUS_ACTIONS.ASSIGNED : undefined);

  const [activeBanner, setActiveBanner] = useState<StatusBanner | null>(null);

  useEffect(() => {
    if (!banner) {
      setActiveBanner(null);
      return;
    }
    setActiveBanner(banner);
    const timeout = setTimeout(() => setActiveBanner(null), 3000);
    return () => clearTimeout(timeout);
  }, [banner, status]);

  // Auto-arrive when within 500m of pickup location
  const hasAutoArrived = useRef(false);
  useEffect(() => {
    if (
      status === 'ON_THE_WAY' &&
      !hasAutoArrived.current &&
      location?.latitude &&
      location?.longitude &&
      pickupCoordinate
    ) {
      const distanceToPickup = calculateDistance(
        location.latitude,
        location.longitude,
        pickupCoordinate.latitude,
        pickupCoordinate.longitude
      );

      // Auto-trigger ARRIVED when within 500 meters (0.5 km)
      if (distanceToPickup <= 0.5) {
        console.log('🎯 Auto-triggering ARRIVED (within 500m)');
        hasAutoArrived.current = true;
        updateStatus('ARRIVED');
        Toast.show({
          type: 'success',
          text1: 'Arrived at Pickup',
          text2: 'You are now at the pickup location',
          position: 'top',
          visibilityTime: 3000,
        });
      }
    } else if (status !== 'ON_THE_WAY') {
      // Reset flag when status changes away from ON_THE_WAY
      hasAutoArrived.current = false;
    }
  }, [status, location, pickupCoordinate, updateStatus]);

  const handlePrimaryAction = useCallback(() => {
    if (!primaryAction) {
      return;
    }
    if (pendingAction?.type === 'STATUS' && pendingAction?.targetStatus === primaryAction.next) {
      return;
    }
    updateStatus(primaryAction.next);
  }, [primaryAction, pendingAction, updateStatus]);

  const handleComplete = useCallback(() => {
    if (pendingAction?.type === 'STATUS') {
      return;
    }
    updateStatus('COMPLETED');
    
    // Navigate to payment collection screen
    navigation.navigate('PaymentCollection', {
      jobId: String(currentJob?.id || ''),
      amount: currentJob?.actualFare || currentJob?.estimatedFare || 0,
      customerId: currentJob?.passenger?.id || null,
      customerName: currentJob?.passenger?.name || 'Passenger',
      driverId: driver?.id,
    });
  }, [navigation, pendingAction?.type, updateStatus, currentJob, driver?.id]);

  const handleCancel = useCallback(() => {
    if (pendingAction?.type === 'STATUS') {
      return;
    }
    updateStatus('CANCELLED');
    navigation.navigate('Home');
  }, [navigation, pendingAction?.type, updateStatus]);

  const { noShowJob, recallJob } = useJob();

  const handleNoShow = useCallback(() => {
    if (pendingAction?.type === 'STATUS') {
      return;
    }

    Alert.alert(
      'Report No Show',
      'Are you sure the rider did not show up? This will complete the job as a no-show.',
      [
        {
          text: 'Cancel',
          style: 'cancel',
        },
        {
          text: 'Yes, No Show',
          style: 'destructive',
          onPress: () => {
            noShowJob();
            Toast.show({
              type: 'info',
              text1: 'No Show Reported',
              text2: 'Job has been marked as no-show',
              position: 'top',
            });
            setTimeout(() => navigation.navigate('Home'), 1500);
          },
        },
      ]
    );
  }, [noShowJob, pendingAction?.type, navigation]);

  const handleRecall = useCallback(() => {
    if (pendingAction?.type === 'STATUS') {
      return;
    }

    Alert.alert(
      'Recall Job',
      'Are you sure you want to recall this job? It will be returned to dispatch and the customer will be notified.',
      [
        {
          text: 'Cancel',
          style: 'cancel',
        },
        {
          text: 'Yes, Recall',
          style: 'destructive',
          onPress: () => {
            recallJob();
            Toast.show({
              type: 'info',
              text1: 'Job Recalled',
              text2: 'Job has been returned to dispatch',
              position: 'top',
            });
            setTimeout(() => navigation.navigate('Home'), 1500);
          },
        },
      ]
    );
  }, [recallJob, pendingAction?.type, navigation]);

  // ✅ CRITICAL FIX: Removed early return to prevent "Rendered fewer hooks" error
  // The useEffect on line 89-94 already handles navigation when no job exists
  // This was causing the job to revert to "Unassigned" when clicking "Arrived"

  const estimatedFareValue =
    typeof currentJob?.estimatedFare === 'number' && Number.isFinite(currentJob.estimatedFare)
      ? Math.max(currentJob.estimatedFare, 0)
      : 0;
  const plannedDistance =
    typeof currentJob?.distance === 'number' && Number.isFinite(currentJob.distance)
      ? Math.max(currentJob.distance, 0)
      : 0;
  const plannedEta =
    typeof currentJob?.estimatedDuration === 'number' && Number.isFinite(currentJob.estimatedDuration)
      ? Math.max(currentJob.estimatedDuration, 0)
      : null;

  const isRideActive = useMemo(() => ['STARTED', 'ACTIVE'].includes(status), [status]);

  // ✨ NEW: Use pricingBreakdown from JobContext (calculated by job processor)
  // Falls back to manual calculation if not available
  const fareDisplay = useMemo(() => {
    if (pricingBreakdown && isRideActive) {
      // Use real-time pricing from job processor
      return {
        base: parseFloat(pricingBreakdown.startingPrice),
        distanceFare: parseFloat(pricingBreakdown.distanceCost),
        timeFare: parseFloat(pricingBreakdown.durationCost),
        waitingFare: parseFloat(pricingBreakdown.waitingCost),
        total: parseFloat(pricingBreakdown.totalCost),
      };
    }
    
    // Fallback: Manual calculation
    const base = selectedTariff?.baseFare ?? 0;
    const distanceFare = (selectedTariff?.perKmRate ?? 0) * (timer.distanceMeters / 1000);
    const timeFare = (selectedTariff?.perMinuteRate ?? 0) * (timer.elapsedSeconds / 60);
    const waitingFare = (selectedTariff?.waitingTimeRate ?? 0) * (timer.waitingSeconds / 60);
    const total = base + distanceFare + timeFare + waitingFare;
    return {
      base,
      distanceFare,
      timeFare,
      waitingFare,
      total
    };
  }, [
    pricingBreakdown,
    isRideActive,
    selectedTariff?.baseFare,
    selectedTariff?.perKmRate,
    selectedTariff?.perMinuteRate,
    selectedTariff?.waitingTimeRate,
    timer.distanceMeters,
    timer.elapsedSeconds,
    timer.waitingSeconds
  ]);
  
  // Only show dropoff on map after ride has started
  const showDropoffOnMap = useMemo(() => 
    ['STARTED', 'ACTIVE', 'REACHED', 'COMPLETED'].includes(status), 
    [status]
  );

  const riderName = currentJob?.passenger?.name || currentJob?.passenger?.id || 'Rider';
  const riderPhone = currentJob?.passenger?.phone || 'Not available';
  const vehicleLabel = currentJob?.vehicleType || 'Vehicle not assigned';
  const jobReference = currentJob?.publicJobId || currentJob?.jobId || currentJob?.internalJobId || currentJob?.id || 'N/A';
  const routeCoordinates = useMemo(
    () => routePoints.map(({ latitude, longitude }) => ({ latitude, longitude })),
    [routePoints]
  );

  const elapsedLabel = formatElapsed(timer.elapsedSeconds);
  const travelledLabel = `${(timer.distanceMeters / 1000).toFixed(2)} km`;
  const fareLabel = `$${(isRideActive ? fareDisplay.total : estimatedFareValue).toFixed(2)}`;

  return (
    <SafeAreaView style={styles.safeArea}>
      <ScrollView contentContainerStyle={styles.content} bounces={false}>
        <View style={styles.header}>
          <Text style={styles.headerTitle}>Job Tracking</Text>
          <Text style={styles.headerSubtitle}>{jobReference}</Text>
        </View>

        {activeBanner ? (
          <View style={styles.statusCard}>
            <Text style={styles.statusTitle}>{activeBanner.title}</Text>
            <Text style={styles.statusSubtitle}>{activeBanner.subtitle}</Text>
          </View>
        ) : null}

        <View style={styles.summaryCard}>
          <View style={styles.summaryHeader}>
            <View style={styles.summaryTitleWrap}>
              <MCIcon name="steering" size={18} color="#f5b400" />
              <Text style={styles.summaryTitle}>Tariff: {selectedTariff?.name || 'N/A'}</Text>
            </View>
            <View style={styles.summaryIcon}>
              <MCIcon name="chart-line" size={18} color="#15c47e" />
            </View>
          </View>

          <View style={styles.fareBlock}>
            <Text style={styles.fareLabel}>Total Fare</Text>
            <Text style={styles.fareValue}>{fareLabel}</Text>
          </View>

          <View style={styles.metricBar}>
            <View style={styles.metricItem}>
              <Text style={styles.metricLabel}>Time</Text>
              <Text style={styles.metricValue}>{elapsedLabel}</Text>
            </View>
            <View style={styles.metricItem}>
              <Text style={styles.metricLabel}>Travelled</Text>
              <Text style={styles.metricValue}>{travelledLabel}</Text>
            </View>
            <View style={styles.metricItem}>
              <Text style={styles.metricLabel}>{isRideActive ? 'Live Fare' : 'Est. Fare'}</Text>
              <Text style={styles.metricValue}>{fareLabel}</Text>
            </View>
          </View>

          <View style={styles.breakdownContainer}>
            <View style={styles.breakdownRow}>
              <View style={styles.breakdownItem}>
                <Text style={styles.breakdownLabel}>Start</Text>
                <Text style={styles.breakdownValue}>${fareDisplay.base.toFixed(2)}</Text>
              </View>
              <View style={styles.breakdownItem}>
                <Text style={styles.breakdownLabel}>Distance</Text>
                <Text style={styles.breakdownValue}>${fareDisplay.distanceFare.toFixed(2)}</Text>
              </View>
            </View>
            <View style={styles.breakdownRow}>
              <View style={styles.breakdownItem}>
                <Text style={styles.breakdownLabel}>Time</Text>
                <Text style={styles.breakdownValue}>${fareDisplay.timeFare.toFixed(2)}</Text>
              </View>
              <View style={styles.breakdownItem}>
                <Text style={styles.breakdownLabel}>Waiting</Text>
                <Text style={styles.breakdownValue}>
                  ${fareDisplay.waitingFare.toFixed(2)}
                  {timer.waitingSeconds > 0 && (
                    <Text style={styles.waitingTime}> ({timer.waitingSeconds}s)</Text>
                  )}
                </Text>
              </View>
            </View>
          </View>
        </View>

        {primaryAction ? (
          <TouchableOpacity
            style={[styles.primaryAction, { backgroundColor: primaryAction.color }]}
            onPress={handlePrimaryAction}
            activeOpacity={0.9}
          >
            <MCIcon name={primaryAction.icon} size={20} color="#fff" />
            <Text style={styles.primaryActionText}>{primaryAction.label}</Text>
          </TouchableOpacity>
        ) : null}

        {/* Additional Action Buttons */}
        {(status === 'ON_THE_WAY' || status === 'ASSIGNED' || status === 'ACCEPTED') && (
          <View style={styles.secondaryActionRow}>
            <TouchableOpacity 
              style={[styles.secondaryActionButton, styles.recallButton]} 
              onPress={handleRecall}
              activeOpacity={0.85}
            >
              <MCIcon name="arrow-u-left-top" size={18} color="#fff" />
              <Text style={styles.secondaryActionText}>Recall</Text>
            </TouchableOpacity>
          </View>
        )}

        {status === 'ARRIVED' && (
          <View style={styles.secondaryActionRow}>
            <TouchableOpacity 
              style={[styles.secondaryActionButton, styles.noShowButton]} 
              onPress={handleNoShow}
              activeOpacity={0.85}
            >
              <MCIcon name="account-cancel" size={18} color="#fff" />
              <Text style={styles.secondaryActionText}>No Show</Text>
            </TouchableOpacity>
            <TouchableOpacity 
              style={[styles.secondaryActionButton, styles.recallButton]} 
              onPress={handleRecall}
              activeOpacity={0.85}
            >
              <MCIcon name="arrow-u-left-top" size={18} color="#fff" />
              <Text style={styles.secondaryActionText}>Recall</Text>
            </TouchableOpacity>
          </View>
        )}

        {/* ✨ NEW: Pause Button when ride is active */}
        {status === 'STARTED' && (
          <TouchableOpacity 
            style={[styles.secondaryActionButton, styles.pauseButton, { marginTop: 12 }]} 
            onPress={async () => {
              await pauseJob();
              navigation.navigate('JobPaused');
            }}
            activeOpacity={0.85}
          >
            <MCIcon name="pause-circle" size={20} color="#fff" />
            <Text style={styles.secondaryActionText}>Pause Ride</Text>
          </TouchableOpacity>
        )}

        <View style={styles.detailCard}>
          <Text style={styles.sectionHeading}>Trip Details</Text>
          <View style={styles.detailRow}>
            <View style={[styles.detailIcon, styles.pickupIcon]}>
              <MCIcon name="map-marker" size={18} color="#22c55e" />
            </View>
            <View style={styles.detailColumn}>
              <Text style={styles.detailLabel}>Pickup</Text>
              <Text style={styles.detailValue}>
                {currentJob?.pickupAddress && currentJob.pickupAddress.length
                  ? currentJob.pickupAddress
                  : 'Pickup not provided'}
              </Text>
            </View>
          </View>
          <View style={styles.detailRow}>
            <View style={[styles.detailIcon, styles.dropoffIcon]}>
              <MCIcon name="flag" size={18} color="#f87171" />
            </View>
            <View style={styles.detailColumn}>
              <Text style={styles.detailLabel}>Dropoff</Text>
              <Text style={styles.detailValue}>
                {currentJob?.dropoffAddress && currentJob.dropoffAddress.length
                  ? currentJob.dropoffAddress
                  : 'Dropoff not provided'}
              </Text>
            </View>
          </View>
          <View style={styles.detailChips}>
            <View style={styles.detailChip}>
              <MCIcon name="map-marker-distance" size={16} color="#60a5fa" />
              <Text style={styles.detailChipText}>Planned {plannedDistance.toFixed(1)} km</Text>
            </View>
            <View style={styles.detailChip}>
              <MCIcon name="clock-outline" size={16} color="#38bdf8" />
              <Text style={styles.detailChipText}>
                ETA {plannedEta ? `${Math.round(plannedEta)} min` : 'N/A'}
              </Text>
            </View>
          </View>
        </View>

        <View style={styles.riderCard}>
          <Text style={styles.sectionHeading}>Rider</Text>
          <View style={styles.riderRow}>
            <MCIcon name="account" size={18} color="#fbbf24" />
            <Text style={styles.riderValue}>{riderName}</Text>
          </View>
          <View style={styles.riderRow}>
            <MCIcon name="phone" size={18} color="#34d399" />
            <Text style={styles.riderValue}>{riderPhone}</Text>
          </View>
          <View style={styles.riderRow}>
            <MCIcon name="car" size={18} color="#60a5fa" />
            <Text style={styles.riderValue}>{vehicleLabel}</Text>
          </View>
        </View>

        <View style={styles.mapCard}>
          <Text style={styles.sectionHeading}>
            {isRideActive ? '🚀 3D Live Tracking' : 'Live Map'}
          </Text>
          <RideMap
            pickup={pickupCoordinate}
            dropoff={showDropoffOnMap ? dropoffCoordinate : undefined}
            driver={driverCoordinate}
            route={routeCoordinates}
            style={styles.map}
            enable3D={isRideActive} // ✨ NEW: 3D view when ride is active
            followDriver={isRideActive} // ✨ NEW: Camera follows driver when active
            height={220}
          />
        </View>

        {isRideActive ? (
          <View style={styles.actionRow}>
            <TouchableOpacity style={[styles.actionButton, styles.completeButton]} onPress={handleComplete}>
              <MCIcon name="check-circle" size={20} color="#fff" />
              <Text style={styles.actionText}>Complete</Text>
            </TouchableOpacity>
            <TouchableOpacity style={[styles.actionButton, styles.pauseButton]} activeOpacity={0.85} disabled>
              <MCIcon name="pause-circle" size={20} color="#fff" />
              <Text style={styles.actionText}>Pause</Text>
            </TouchableOpacity>
            <TouchableOpacity style={[styles.actionButton, styles.cancelButton]} onPress={handleCancel}>
              <MCIcon name="close-circle" size={20} color="#fff" />
              <Text style={styles.actionText}>Cancel</Text>
            </TouchableOpacity>
          </View>
        ) : null}
      </ScrollView>
    </SafeAreaView>
  );
};

const styles = StyleSheet.create({
  safeArea: {
    flex: 1,
    backgroundColor: '#05060A',
  },
  content: {
    padding: 20,
    paddingBottom: 36,
    gap: 18,
  },
  header: {
    gap: 4,
  },
  headerTitle: {
    color: '#f8fafc',
    fontSize: 20,
    fontWeight: '700',
  },
  headerSubtitle: {
    color: '#94a3b8',
    fontSize: 13,
  },
  statusCard: {
    backgroundColor: '#ffffff',
    borderRadius: 14,
    padding: 16,
    gap: 4,
    borderWidth: 1,
    borderColor: 'rgba(22,163,74,0.15)',
  },
  statusTitle: {
    color: '#16a34a',
    fontSize: 15,
    fontWeight: '700',
  },
  statusSubtitle: {
    color: '#4b5563',
    fontSize: 13,
  },
  summaryCard: {
    backgroundColor: '#0F172A',
    borderRadius: 20,
    borderWidth: 1,
    borderColor: 'rgba(148,163,184,0.25)',
    padding: 20,
    gap: 20,
  },
  summaryHeader: {
    flexDirection: 'row',
    justifyContent: 'space-between',
    alignItems: 'center',
  },
  summaryTitleWrap: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 8,
  },
  summaryTitle: {
    color: '#f8fafc',
    fontSize: 14,
    fontWeight: '600',
  },
  summaryIcon: {
    padding: 8,
    borderRadius: 12,
    backgroundColor: 'rgba(21,196,126,0.18)',
  },
  fareBlock: {
    gap: 6,
  },
  fareLabel: {
    color: '#94a3b8',
    fontSize: 12,
    textTransform: 'uppercase',
    letterSpacing: 0.6,
  },
  fareValue: {
    color: '#fef3c7',
    fontSize: 36,
    fontWeight: '700',
  },
  metricBar: {
    flexDirection: 'row',
    justifyContent: 'space-between',
    gap: 12,
    backgroundColor: 'rgba(15,23,42,0.85)',
    borderRadius: 16,
    paddingVertical: 16,
    paddingHorizontal: 18,
  },
  metricItem: {
    flex: 1,
    alignItems: 'center',
    gap: 6,
  },
  metricLabel: {
    color: '#94a3b8',
    fontSize: 11,
    textTransform: 'uppercase',
    letterSpacing: 0.6,
  },
  metricValue: {
    color: '#e2e8f0',
    fontSize: 16,
    fontWeight: '600',
  },
  breakdownContainer: {
    gap: 12,
    borderTopWidth: 1,
    borderTopColor: 'rgba(148,163,184,0.25)',
    paddingTop: 16,
  },
  breakdownRow: {
    flexDirection: 'row',
    gap: 12,
  },
  breakdownItem: {
    flex: 1,
    alignItems: 'center',
    gap: 4,
  },
  breakdownLabel: {
    color: '#94a3b8',
    fontSize: 11,
    textTransform: 'uppercase',
    letterSpacing: 0.6,
  },
  breakdownValue: {
    color: '#fef3c7',
    fontSize: 14,
    fontWeight: '600',
  },
  waitingTime: {
    color: '#94a3b8',
    fontSize: 12,
    fontWeight: '400',
  },
  primaryAction: {
    borderRadius: 28,
    paddingVertical: 16,
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'center',
    gap: 10,
  },
  primaryActionText: {
    color: '#fff',
    fontSize: 16,
    fontWeight: '700',
  },
  detailCard: {
    backgroundColor: '#0B1120',
    borderRadius: 20,
    borderWidth: 1,
    borderColor: 'rgba(148,163,184,0.2)',
    padding: 20,
    gap: 16,
  },
  sectionHeading: {
    color: '#94a3b8',
    fontSize: 12,
    textTransform: 'uppercase',
    letterSpacing: 0.8,
  },
  detailRow: {
    flexDirection: 'row',
    alignItems: 'flex-start',
    gap: 12,
  },
  detailIcon: {

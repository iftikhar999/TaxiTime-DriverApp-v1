<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug mode: Allow all cleartext traffic and trust all certificates -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
    
    <!-- Allow cleartext for ALL domains in base config -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>

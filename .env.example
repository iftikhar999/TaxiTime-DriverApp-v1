# Driver app v1 — environment configuration
# Copy this file to `.env` and fill in values. Values are loaded at build time
# by react-native-config (Android: app/build.gradle, iOS: Info.plist).
#
# After changing .env you MUST rebuild the native app. Metro bundler alone
# will NOT pick up changes.

# Backend base URL (no trailing slash, no /api suffix).
# DEV examples:
#   Android emulator (host loopback): http://10.0.2.2:3000
#   iOS simulator:                    http://localhost:3000
#   Physical device on LAN:           http://192.168.1.48:3000
# PROD:
#   Must be https:// — cleartext is only allowed for dev loopback IPs in
#   android/app/src/main/res/xml/network_security_config.xml.
API_BASE_URL=http://10.0.2.2:3000

# Stripe publishable key (pk_test_* in dev, pk_live_* in prod).
# Get from https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=

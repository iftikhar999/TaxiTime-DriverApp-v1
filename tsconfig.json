{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@theme/*": ["src/theme/*"],
      "@screens/*": ["src/screens/*"],
      "@components/*": ["src/components/*"],
      "@services/*": ["src/services/*"],
      "@context/*": ["src/context/*"],
      "@navigation/*": ["src/navigation/*"]
    }
  },
  "include": [
    "src/**/*",
    "index.js",
    "App.tsx"
  ]
}
